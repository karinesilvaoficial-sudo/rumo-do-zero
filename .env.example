# RUMO — variáveis por ambiente. NUNCA commitar valores reais; use o gerenciador de variáveis da Vercel.
# ---- Público (vai ao navegador) ----
NEXT_PUBLIC_APP_URL=https://app.exemplo.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ---- Servidor (somente Node) ----
APP_ENV=development            # development | test | preview | production
SUPABASE_SECRET_KEY=           # service role: só webhooks, cron e filas
ANALYTICS_URL=                 # URL do projeto Vercel apps/analytics
RUMO_SERVICE_SECRET=           # >= 32 caracteres; o MESMO valor no projeto analytics
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=1000
AI_PRICE_IN_USD_PER_MTOK=      # preços datados (ver docs/custos.md); vazio = custo não registrado
AI_PRICE_OUT_USD_PER_MTOK=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=           # voz criada no Voice Design (ver docs/voz.md) — não inventar
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
STRIPE_SECRET_KEY=             # chave restrita do modo de teste em dev/preview
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_MONTH=
STRIPE_PRICE_MAX_YEAR=
STRIPE_PRICE_UNLIMITED_MONTH=
STRIPE_PRICE_UNLIMITED_YEAR=
STRIPE_PIX_ENABLED=false       # true só após confirmar elegibilidade do Pix na conta
RESEND_API_KEY=
EMAIL_FROM="RUMO <nao-responda@exemplo.com.br>"
CRON_SECRET=                   # >= 32 caracteres

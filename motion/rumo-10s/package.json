{
  "name": "rumo-motion-10s",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts RumoAd renders/rumo_motion_10s.mp4 --codec=h264 --crf=16",
